# Node / Vite
node_modules
dist

# Rust
src-tauri/target

# Generated by tauri
src-tauri/gen/schemas

# FFmpeg sidecar binaries: fetched by `npm install` (scripts/fetch-ffmpeg.mjs)
# against the pinned checksums in scripts/ffmpeg-manifest.json. Never commit
# the binaries themselves.
src-tauri/binaries/

# Media never belongs in git — recordings are participant data (IRB 2020-1657).
# EXCEPTION: the eight committed PPS demo clips, which the station's video task
# falls back to when no stimulus folder is configured. Without this un-ignore
# they silently vanish (the trap that bit the standalone repos' merge review).
*.mp4
!public/videos/*.mp4
*.mkv
*.webm

# Study output that a local test run drops into the working tree
ratings.csv
transitions.csv

# The full stimulus library lives on the Research Drive, not in git
mp4_noname/

# Randy's design PDF sits in the folder for reference, never in the repo
*.pdf

# Editors / OS
.DS_Store
Thumbs.db
.vscode
.idea
.vercel/
