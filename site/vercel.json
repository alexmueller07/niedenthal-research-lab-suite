{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/NiedenthalLabSuite-Setup.exe",
      "destination": "https://github.com/alexmueller07/niedenthal-research-lab-suite/releases/latest/download/NiedenthalLabSuite-Setup.exe",
      "permanent": false
    },
    {
      "source": "/NiedenthalLabSuite.dmg",
      "destination": "https://github.com/alexmueller07/niedenthal-research-lab-suite/releases/latest/download/NiedenthalLabSuite.dmg",
      "permanent": false
    }
  ]
}
