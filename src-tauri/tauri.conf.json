{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Niedenthal Lab Suite",
  "version": "0.1.0",
  "identifier": "edu.wisc.niedenthal.lab-suite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
