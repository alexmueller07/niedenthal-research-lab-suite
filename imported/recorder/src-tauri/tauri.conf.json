{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lab Recorder",
  "version": "0.1.0",
  "identifier": "edu.wisc.niedenthal.lab-recorder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lab Recorder",
        "width": 1280,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
